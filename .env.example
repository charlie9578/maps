# Copy to `.env` in the repo root (same folder as README.md).
# `.env` is gitignored — never commit real keys.

# TfL Unified API — https://api-portal.tfl.gov.uk/
# Sign in → Products → subscribe to the 500 req/min plan → Profile → Subscriptions
# → copy your Primary key (app_id is no longer required per TfL portal, June 2026).
TFL_APP_KEY=your-primary-key-here

# Copy to `.env` in the repo root (same folder as README.md).
# `.env` is gitignored — never commit real keys.
#
# Add one block per external API your maps use. Document each variable in the
# relevant map README and load via `from lib.env import load_repo_env`.

# --- TfL Unified API (maps/tfl-live-map) ---
# Portal: https://api-portal.tfl.gov.uk/
# Sign in → Products → subscribe → Profile → Subscriptions → Primary key
# (app_id is no longer required per TfL portal, June 2026)
TFL_APP_KEY=your-primary-key-here

# Optional TfL tuning (defaults shown in tfl-live-map README)
# TFL_ANIMATION_MS=500
# TFL_REFRESH_CYCLE_SECS=30
# TFL_CACHE_MAX_AGE_DAYS=90
# TFL_REFRESH_CACHE=0

# --- Other providers (examples — uncomment and rename as needed) ---
# SOME_API_KEY=your-key-here
# SOME_API_BASE_URL=https://api.example.com
